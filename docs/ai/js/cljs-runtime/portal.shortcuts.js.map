(ns ^:no-doc portal.shortcuts
  (:require [clojure.string :as str]))

(defn- get-platform []
  (let [platform #?(:clj  (System/getProperty "os.name")
                    :cljs js/window.navigator.platform)]
    (cond
      (#{"Macintosh" "MacIntel" "MacPPC" "Mac68K"} platform)  ::osx
      (#{"Win32" "Win64" "Windows" "WinCE"} platform)         ::windows
      (str/includes? platform "Linux")                        ::linux)))

(defn platform-supported? [shortcut]
  (let [platform (get-platform)]
    (cond
      (::osx (meta shortcut))     (= ::osx platform)
      (::windows (meta shortcut)) (= ::windows platform)
      (::linux (meta shortcut))   (= ::linux platform)
      :else                       true)))

(defn get-shortcut [definition]
  (cond
    (string? definition) #{definition}

    (map? definition)
    (or (get definition (get-platform))
        (get definition ::default))

    :else definition))

(defn- event->key [e]
  (when-let [k #?(:clj  (:key e)
                  :cljs (.-key e))]
    (str/lower-case k)))

(defn- log->seq
  "Returns all key sequences in the event log."
  [log]
  (let [log (map event->key log)]
    (for [n (reverse (map inc (range (count log))))]
      (into [] (reverse (take n log))))))

(defn- log->combo
  "Return the last key combo from the event log."
  [log]
  (when-let [e (first log)]
    (cond-> #{(event->key e)}
      #?(:clj (:ctrl-key e)  :cljs (.-ctrlKey e))  (conj "control")
      #?(:clj (:meta-key e)  :cljs (.-metaKey e))  (conj "meta")
      #?(:clj (:shift-key e) :cljs (.-shiftKey e)) (conj "shift")
      #?(:clj (:alt-key e)   :cljs (.-altKey e))   (conj "alt"))))

(defonce ^:private log (atom nil))
(def ^:dynamic *log* nil)

(defn clear! [] (reset! (or *log* log) (list)))

(defn match? [definition log]
  (some (fn [combo]
          (= combo (get-shortcut definition)))
        (concat [(log->combo log)] (log->seq log))))

(defn match [mapping log]
  (or (get mapping (log->combo log))
      (some #(get mapping %) (log->seq log))))

(defn input? [log]
  (when-let [e (first log)]
    (#{"BUTTON" "INPUT" "SELECT" "TEXTAREA"}
     #?(:clj  (get-in e [:target :tag-name])
        :cljs (.. e -target -tagName)))))

(defn keydown [e] (swap! (or *log* log) #(take 5 (conj % e))) nil)

(defn- init []
  (when (nil? @(or *log* log))
    (clear!)
    #?(:cljs (.addEventListener js/window "blur" #(clear!)))
    #?(:cljs (.addEventListener js/window "keydown" #(keydown %)))))

(defn matched! [_log]
  (clear!)
  #?(:cljs (when-let [e (first _log)] (.preventDefault ^js e))))

(defn add! [k f]
  (init)
  (add-watch
   (or *log* log) k
   (fn [_ _ _ log]
     (when-not (empty? log)
       (f log)))))

(defn remove! [k] (remove-watch (or *log* log) k))

